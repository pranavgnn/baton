{
  "name": "promotion-application-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names next,worker --prefix-colors cyan,magenta \"next dev\" \"pnpm worker\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "compose:up": "docker compose -p promotion-portal up -d",
    "compose:down": "docker compose -p promotion-portal down",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "e2e:setup": "pnpm db:reset && pnpm seed && pnpm seed:demo",
    "test:e2e:ui": "playwright test --ui",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/email-worker.ts",
    "dev:next": "next dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@better-auth/core": "1.7.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-underline": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@xyflow/react": "^12.11.5",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tiptap/html": "3.30.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.18.0"
}
