NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- SMTP (Mailpit in development) ------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
