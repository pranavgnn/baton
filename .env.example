# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baton"

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-production-0123456789abcdef"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- SMTP (Mailpit in development) ------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="Baton <no-reply@example.org>"

# --- Email queue (Kafka) -----------------------------------------------------
# Workflow email is published here and delivered by `pnpm worker`, so a slow
# mail server never holds up a review.
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="baton"

# --- Object storage (MinIO / any S3-compatible service) ----------------------
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="baton"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# --- Seeded super admin -----------------------------------------------------
SUPER_ADMIN_EMAIL="admin@example.org"
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PASSWORD="SuperAdmin@123"
